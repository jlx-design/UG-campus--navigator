{
  "name": "UG Navigator — University of Ghana",
  "short_name": "UG Navigator",
  "description": "3D campus map, step-by-step walking directions, lecture timetable, shuttles, emergency contacts and an AI campus guide for the University of Ghana, Legon.",
  "id": "./",
  "start_url": "./#/map",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b1b3a",
  "theme_color": "#0b1b3a",
  "categories": ["education", "navigation", "travel"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Directions", "url": "./#/navigate", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My timetable", "url": "./#/schedule", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Emergency", "url": "./#/emergency", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
