# ───── Frontend (public, non-secret; baked in at build time — defaults live in web/src/config.ts) ─────
UGNAV_DATA_API_URL=https://<endpoint>.apirest.<cell>.<region>.aws.neon.tech/<db>/rest/v1
UGNAV_AUTH_URL=https://<endpoint>.neonauth.<cell>.<region>.aws.neon.tech/<db>/auth
UGNAV_API_URL=https://<branch>-api.compute.<cell>.<region>.aws.neon.tech
# Optional: a tile provider with a key-free URL template (OSM standard tiles are for light use only)
UGNAV_TILE_URL=
UGNAV_TILE_ATTRIBUTION=

# ───── Server function "api" (set as Neon Function environment variables — NEVER in the frontend) ─────
UGNAV_DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<cell>.<region>.aws.neon.tech/<db>?sslmode=require
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<cell>.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
ALLOWED_ORIGINS=https://ug-campus-navigator.netlify.app
ORS_API_KEY=            # openrouteservice key (https://openrouteservice.org/dev/#/signup) — enables /route
ANTHROPIC_API_KEY=      # enables /assistant
AI_MODEL=claude-sonnet-5-5
